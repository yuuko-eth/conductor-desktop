# Conductor Desktop Executor — env config
#
# Source this before running `conductor-desktop`, or pass it as env in your MCP
# client config (see examples/clients/).
#
# These were CONDUCTOR_MCP_* before the rename. The old names still work (a
# CONDUCTOR_DESKTOP_* name wins if both are set); the server logs a
# deprecation warning at startup naming the ones to rename.

# OPTIONAL — OpenAI-compatible VLM server for grounding (Qwen3-VL-4B recommended).
#
# The server starts and runs without it. What changes is which tools work:
#
#   Need a grounder   locate, click, double_click, right_click, drag, read_grid,
#                     crop(target=...), read_screen / describe_image (a describe
#                     model — GROUNDER_URL serves both, or set DESCRIBE_URL)
#   Work without one  ui_tree / ui_find and the ui_* actions (native apps, by
#                     accessibility tree), web_* (browser pages, by selector),
#                     get_scene_graph / list_windows (window topology),
#                     capture_screen (the raw image), and click_at / type_text /
#                     key / hotkey on coordinates you already have — ui_tree and
#                     get_scene_graph both hand you real bounds to click.
#
# A tool that needs one and doesn't have one does NOT fail silently or crash the
# server: it returns an error written for the calling agent, naming the tool, the
# env var to set, and the modality to use instead. So an agent on a grounder-less
# host can read that and re-plan onto ui_* or web_* by itself.
#
# Leave it unset for a host that drives native apps and browsers only — that path
# needs no VLM at all. See https://docs.conductor-mcp.io/guides/native-apps/ for what the accessibility modality
# covers, and https://docs.conductor-mcp.io/platforms/ for where it works.
CONDUCTOR_DESKTOP_GROUNDER_URL=http://grounder.internal:8080

# ── Audit log ────────────────────────────────────────────────────────
# One JSON line per tool call, one file per day, under AUDIT_DIR. ON by
# default: this server hands an agent a real keyboard, mouse and shell, and
# the operator should get an independent record of what it did with them.
# Full story, including how to read and clean up the files: https://docs.conductor-mcp.io/security/audit-log/
# CONDUCTOR_DESKTOP_AUDIT=true
#
# Where the files live. Default: ~/.conductor-desktop/logs (same path on every OS).
# CONDUCTOR_DESKTOP_AUDIT_DIR=/var/log/conductor-desktop
#
# How much of each call's ARGUMENTS is recorded. Arguments carry whatever the
# agent typed, so this decides whether passwords can land on disk:
#   none     - tool names, timings and outcomes only
#   redacted - (default) argument names kept; values for text/value/js/
#              command/password/token/... become "<redacted:N chars>"
#   full     - values kept (capped). CAPTURES TYPED PASSWORDS — debugging only.
# CONDUCTOR_DESKTOP_AUDIT_ARGS=redacted
#
# Delete audit files older than this many days, at server start. 0 = keep
# forever (for a host that ships them off to a collector).
# CONDUCTOR_DESKTOP_AUDIT_RETENTION_DAYS=14

# Which executor backend to drive.
#   resident = local machine (default)
#   vnc      = remote VNC server (set CONDUCTOR_DESKTOP_CONNECTION_URI=vnc://host:port)
#   adb      = Android device (set CONDUCTOR_DESKTOP_CONNECTION_URI=adb://serial)
CONDUCTOR_DESKTOP_BACKEND=resident

# Required for vnc/adb backends — the connection URI for the target host.
# CONDUCTOR_DESKTOP_CONNECTION_URI=vnc://user:pass@10.0.0.50:5900

# Force the desktop route instead of detecting it (diagnose shows the detected
# one and why). One of: linux-x11, linux-gnome, linux-kde, linux-wlroots,
# freebsd-x11, macos, windows, haiku. Unknown values are ignored with a warning.
# CONDUCTOR_DESKTOP_PLATFORM=linux-wlroots

# Return a post-action observation after pointer/window tool calls.
# Set to false if the driver will explicitly call capture_screen() or read_screen()
# when it needs to see — saves context on scripted SOPs (compliance-bot style).
CONDUCTOR_DESKTOP_AUTO_SCREENSHOT=true

# Text-only mode — RECOMMENDED for medium/high-difficulty navigation. Describe
# text (~200-500 tokens/screen) preserves recall budget for on-page content
# vs raw images (~1500-3000 tokens), and text-only context appends cleanly
# so the harness's prefix cache survives — empirically ~3x faster per turn
# on Qwen3.5-27B + 1-slot llama-server. Also the right choice for drivers
# that cannot ingest images at all. When true:
#   - post-action observations become VLM-generated descriptions, not screenshots
#   - explicit capture_screen() still returns the image AND adds a description
#   - explicit crop() still returns the cropped image AND adds a description
#   - driver can also call the `read_screen(hint?)` tool for on-demand state
# Costs one extra VLM round-trip per observed action. Turn off AUTO_SCREENSHOT
# too if you want fully silent actions with read_screen() called explicitly.
CONDUCTOR_DESKTOP_TEXT_ONLY=false

# Downsize screenshots sent to the GROUNDER (VLM input). 0 disables.
# 1280 is a good default for 4K displays — affects grounder cost + latency.
CONDUCTOR_DESKTOP_SCREENSHOT_MAX_WIDTH=0

# Cap on the LONG edge (px) of the INLINE image returned to the MCP caller.
# 1568 is about where the Claude API shrinks images itself, so a laptop
# screen goes out unscaled. A shrunk image's reply says the scale, and the
# coordinate tools take image_coords=true to map image pixels back. Disk
# copies (file/both mode) always stay native resolution. 0 disables the cap.
# (Replaces CONDUCTOR_DESKTOP_PAYLOAD_MAX_WIDTH, which now fails startup.)
CONDUCTOR_DESKTOP_PAYLOAD_MAX_EDGE=1568

# How screenshots come back to the driver.
#   inline = embed the PNG as MCP image content (default; some clients
#            truncate large images — if your driver stops "seeing" after
#            screenshots, try `file` or `both`)
#   file   = write to disk and return just a short path pointer; the
#            driver uses its own Read() to view. Bypasses client-side
#            image-result size limits cleanly. ONLY works when driver
#            and server share a filesystem (stdio transport, or server
#            over SSH tunnel with shared home dir).
#   both   = inline image AND file path. Best-of-both on compliant clients.
CONDUCTOR_DESKTOP_SCREENSHOT_MODE=inline

# Where file/both mode writes PNGs. Auto-created on first write.
# CONDUCTOR_DESKTOP_SCREENSHOT_DIR=~/.conductor-desktop/screenshots

# Append a trailing "[NNms]" / "[N.NNs]" line to every tool result so you
# can see per-call latency. Off by default; flip on when profiling or
# investigating sluggish behavior. No effect on tool semantics.
CONDUCTOR_DESKTOP_TOOL_TIMING=false

# Operator dashboard (recent calls, config, permission check) at
# http://HOST:PORT/dashboard. Off by default. Under http/sse it shares the MCP
# port; under stdio it starts a sidecar HTTP server on HOST:PORT, and the tray
# menu gains "Open dashboard". Off loopback it takes the auth token below.
CONDUCTOR_DESKTOP_DASHBOARD=false

# Desktop input lock file (default ~/.conductor/desktop.lock). Only one server
# per lock file may inject input; others serve read-only tools. Leave unset
# unless you know two servers must not exclude each other (e.g. a test run).
# CONDUCTOR_DESKTOP_LOCK_PATH=

# Perception delta channel — append a "[deltas …]" block to every tool
# result describing structural events (focus changes, value writes,
# navigations, …) emitted between this call and the previous one.
# Sources: macOS AX, Linux AT-SPI, Windows WinEvent (per platform), plus
# CDP (per web_* call). On by default — cheap structural cues are usually
# a strict win for the brain. Flip off when:
#   - the driver is image-only and ignores text deltas anyway,
#   - you want fully deterministic envelopes for golden-file tests, or
#   - a noisy host (e.g. macOS Terminal storm) is drowning useful signal.
# When false: desktop observers are not started, CDP per-call observers
# are skipped, and tool results carry no delta block.
CONDUCTOR_DESKTOP_DELTAS=true

# Coordinate space of a qwen or gemma4 grounder's answer, when it differs from
# the family's own (norm1000). Leave unset for Qwen3-VL and Gemma 4; set
# image_pixels for a model that answers in pixels of the image it was sent
# (Qwen2.5-VL). The point families (holo, venus, uitars, ...) fix their own.
#CONDUCTOR_DESKTOP_COORD_SYSTEM=image_pixels

# Which model-family dialect the grounder client speaks. Drives the system
# prompt, JSON bbox key, axis order, and per-request max_tokens budget.
#   qwen   = Qwen3-VL-Instruct family (default; tightest fit for the
#            current grounder protocol; pixel `bbox_2d: [x1,y1,x2,y2]`)
#   gemma4 = Gemma 4 (E2B / E4B) — native `box_2d: [y1,x1,y2,x2]` 0..1000
#            normalized, with a larger max_tokens budget for Gemma's
#            <|channel>thought reasoning. NOTE: Gemma 4 is a second-class
#            grounder — false negatives on visible elements and occasional
#            confident hallucinations on ambiguous targets are documented
#            behavior. Prefer `qwen` for production; use `gemma4` only when
#            no Qwen-VL endpoint is available.
#   holo   = HCompany Holo-3.1 (0.8B/3B/7B) — a single-point GUI grounder.
#            Best-in-class PRECISE CLICK (e.g. lands the exact spreadsheet
#            cell where qwen is off by 1-3), Apache-2.0, and tiny (0.8B ≈
#            1.5 GB VRAM). It returns a click POINT only — no bounding box —
#            and cannot describe. So it is ONLY usable paired with a
#            bbox-capable describe backend (see DESCRIBE_URL below): describe
#            AND region ops (crop, locate.bbox, locate(multiple=True)) route
#            there automatically. This is the recommended commercial-safe
#            precise-click setup — see "Grounder ensembles" below.
#   locateanything = NVIDIA LocateAnything-3B — purpose-built grounder with
#            real boxes + multi-instance enumeration. NON-COMMERCIAL license.
#            Also grounding-only → requires a separate describe backend.
#            Server must be launched with `--special`.
CONDUCTOR_DESKTOP_GROUNDER_FAMILY=qwen

# Grounder HTTP timeout (seconds).
CONDUCTOR_DESKTOP_GROUNDER_TIMEOUT=30

# ---------------------------------------------------------------------------
# Grounder ensembles — split the describe / region role onto a second server
# ---------------------------------------------------------------------------
#
# There are three grounding capabilities, and one server need not serve all
# three:
#   * point  (precise click) → `click`, `locate(x,y)`, `wait_for`
#   * describe (prose)       → `describe`, text-only post-action observations
#   * region (extent)        → `crop`, `locate.bbox`, `locate(multiple=True)`
#
# The GROUNDER_URL/FAMILY above is the POINT/click backend. When it can also
# describe and do boxes (qwen, gemma4), it serves all three roles and you need
# nothing else — the historical single-server setup.
#
# When the point backend is grounding-only (holo, locateanything), point a
# DESCRIBE backend at a Qwen3-VL/Gemma server. describe routes there, and so do
# region ops automatically (a point-only grounder like holo can't draw a real
# box). The server resolves this at startup; `diagnose` prints all three roles
# and a license/commercial-safety verdict.
#
#   describe_url alone  → same dialect as GROUNDER_FAMILY, different URL
#   describe_family alone → different dialect on the SAME url (multi-model server)
#   both                → fully independent describe/region backend
#
# RECOMMENDED commercial-safe precise-click ensemble (qwen + holo, all
# Apache-2.0): point/click on Holo, describe + region on Qwen3-VL.
#   CONDUCTOR_DESKTOP_GROUNDER_URL=http://127.0.0.1:8930
#   CONDUCTOR_DESKTOP_GROUNDER_FAMILY=holo
#   CONDUCTOR_DESKTOP_DESCRIBE_URL=http://127.0.0.1:8922
#   CONDUCTOR_DESKTOP_DESCRIBE_FAMILY=qwen
#
# CONDUCTOR_DESKTOP_DESCRIBE_URL=
# CONDUCTOR_DESKTOP_DESCRIBE_FAMILY=

# ---------------------------------------------------------------------------
# Transport — how the MCP client talks to this server
# ---------------------------------------------------------------------------
#
# stdio = default, server spawned as a child process by the MCP client (local)
# sse   = server-sent events over HTTP (older MCP transport, broad client support)
# http  = streamable HTTP (current MCP spec direction, best with recent clients)
#
# For cross-machine use (e.g. drive from laptop, execute on spare mac), pick
# sse or http and set CONDUCTOR_DESKTOP_HOST to 0.0.0.0 or your LAN IP.
CONDUCTOR_DESKTOP_TRANSPORT=stdio

# Only used when transport is sse or http (or the dashboard is on).
# 127.0.0.1 is safe (localhost-only). Any other address serves this desktop
# to the network, and the server refuses to start that way without an auth
# token (below). Recommended: keep bound to 127.0.0.1 and use `ssh -L` to
# tunnel from the driver machine — you get auth + encryption for free.
CONDUCTOR_DESKTOP_HOST=127.0.0.1
CONDUCTOR_DESKTOP_PORT=8765

# Bearer token for every HTTP route: the MCP transport and the dashboard.
# Clients send `Authorization: Bearer <token>`; the tray's "Open dashboard"
# logs the browser in for you. Required for a non-loopback HOST, optional on
# loopback. Plain HTTP, so the token crosses the network unencrypted: use it
# on a LAN you trust. Prefer the file (mode 600); either variable is removed
# from the server's environment once read, so exec_shell can't print it.
# At least 16 characters: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# CONDUCTOR_DESKTOP_AUTH_TOKEN_FILE=~/.conductor-desktop/token
# CONDUCTOR_DESKTOP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Host permissions — required before the server will start
# ---------------------------------------------------------------------------
#
# conductor-desktop refuses to start without the ability to capture the screen
# and inject input. macOS TCC grants attach to the *launching* process, so
# the permission must be granted to the terminal (or IDE/launcher) that
# will spawn this server, not to `conductor-desktop` or `python`.
#
# Run this to check before starting:
#
#     conductor-desktop-check
#     # or, if not installed as a console script:
#     python -m conductor_desktop.check_permissions
#
# macOS: System Settings → Privacy & Security → grant Screen Recording
#   AND Accessibility to iTerm2 / Terminal.app / Ghostty / whichever you use.
#   Fully quit (Cmd-Q) and relaunch the terminal after granting.
#
# Linux Wayland: user must be in the `input` group; see setup-deps-*.sh.
# Linux X11 / Windows: no special grants needed.
#
# When the driving agent hits a failure, it can also call the `diagnose`
# MCP tool at runtime to read the current permission state.

# ---------------------------------------------------------------------------
# Chrome DevTools Protocol — powers the web_eval / web_crop tools
# ---------------------------------------------------------------------------
#
# Launch Chrome with `--remote-debugging-port=9222 --user-data-dir=<path>`
# (a dedicated profile dir is required on macOS). When unreachable, web_eval
# / web_crop return a friendly error; web_js_snippet / web_mark don't need
# CDP — they drive Chrome via the URL bar.
CONDUCTOR_DESKTOP_CDP_HOST=127.0.0.1
CONDUCTOR_DESKTOP_CDP_PORT=9222
# Default case-insensitive substring matched against tab URL/title when a
# tool call omits `tab`. Empty = first page target.
# CONDUCTOR_DESKTOP_CDP_TAB_FILTER=dash.cloudflare.com
#
# Several browsers: name each one with a slug the web_* tools accept as
# `browser=` (and as tab handles like `firefox:3`). Scheme is the transport:
# cdp (Chromium) or bidi (Firefox WebDriver BiDi — launch Firefox with
# `--remote-debugging-port=9223`). When set, CDP_HOST/CDP_PORT are ignored.
# CONDUCTOR_DESKTOP_BROWSERS=chrome=cdp://127.0.0.1:9222,firefox=bidi://127.0.0.1:9223
# Browser used when a call names none and several are reachable.
# CONDUCTOR_DESKTOP_DEFAULT_BROWSER=chrome

# ---------------------------------------------------------------------------
# Optional tool families — registration gates
# ---------------------------------------------------------------------------
#
# These toggles control whether a whole family of tools is REGISTERED on the
# MCP surface. When a family is off, its tools are absent entirely (not
# present-but-erroring) — the model never sees them, saving context. Flip
# them to shrink the surface to what a given host actually does.

# Web / Chrome-DevTools tools (web_eval, web_crop, web_list_tabs, activate_tab,
# web_js_snippet, web_mark). Default ON — set false on hosts that never drive a
# browser to drop all six.
# CONDUCTOR_DESKTOP_WEB=false

# exec_shell — arbitrary shell on the host (and mobile_shell on a device).
# Default ON — set false for locked-down deployments that must not expose a
# shell; it removes both tools.
# CONDUCTOR_DESKTOP_SHELL=false

# describe_image — read an arbitrary PNG/JPEG on disk and describe it as prose
# (webcam frames, saved photos). Split out of read_screen (which is now
# screen-only). Default OFF — mainly for text-only-brain hosts. See https://docs.conductor-mcp.io/guides/webcam/.
# CONDUCTOR_DESKTOP_DESCRIBE_IMAGE=true

# Two more families are gated elsewhere in this file:
#   - enumerate_elements → registers only when CONDUCTOR_DESKTOP_OMNIPARSER_URL is
#     set (or managed mode). See the OmniParser section.
#   - mobile_* → registers only when a mobile transport is enabled. See below.

# ---------------------------------------------------------------------------
# Mobile — Android via adb, iOS via WebDriverAgent (WDA) HTTP
# ---------------------------------------------------------------------------
#
# Mobile is an *additive* surface: the host backend still owns the desktop;
# mobile_* tools sit alongside, with device_id-routed perception (capture_screen,
# locate, crop, read_screen, list_windows). Each transport has its own gate
# because adb is a single-binary install while WDA needs Xcode + per-device
# pairing — users commonly have one but not the other. Off by default; when
# both are unset the seven mobile_* tools are absent from the surface entirely.

# --- Android (adb) ---
# Requires `adb` on PATH (Android Platform Tools). USB debugging must be
# enabled on the device + the host fingerprint trusted ("device" state in
# `adb devices`, NOT "unauthorized" or "offline").
# CONDUCTOR_DESKTOP_MOBILE_ANDROID=true

# --- iOS (WDA HTTP) ---
# Requires:
#   1. WebDriverAgentRunner.app installed on the iPhone (one-time Xcode
#      build + sign with a Free / Apple Developer signing identity).
#   2. `xcodebuild test-without-building -scheme WebDriverAgentRunner ...`
#      running on a Mac that has the iPhone connected via USB (this Mac OR
#      a different "build host" — they don't have to be the same machine).
#   3. WDA's HTTP server reachable from THIS host. Two transport options:
#        a) Wi-Fi: WDA listens on the iPhone's Wi-Fi IP, port 8100. Set
#           CONDUCTOR_DESKTOP_MOBILE_IOS_WDA_URL=http://<iphone-wifi-ip>:8100
#        b) USB-mux forward: run `pymobiledevice3 usbmux forward 8100 8100
#           --udid <UDID>` (or `iproxy 8100 8100`) on this same host with
#           the iPhone USB-attached, then point at http://127.0.0.1:8100.
#   4. `pymobiledevice3` on PATH for richer metadata (real UDID, battery,
#      DeviceName). Without it, the server falls back to "WDA-only mode"
#      where mobile_list_devices synthesizes the device record from WDA's
#      /wda/device/info (using identifierForVendor as the device_id).
#
# Test device should have NO PASSCODE — iOS exposes no programmatic unlock
# and WDA's `unlock` is a no-op when a passcode is set. Settings → Display
# & Brightness → Auto-Lock: Never (only available with no passcode).
#
# CONDUCTOR_DESKTOP_MOBILE_IOS=true
# CONDUCTOR_DESKTOP_MOBILE_IOS_WDA_URL=http://<iphone-wifi-ip>:8100
